aws_account_id = "123456789012"
allowed_cidrs  = ["203.0.113.10/32"] # your public IPv4 (CloudFront allowlist)
image_tag      = ""                  # set to the pushed git SHA for the second apply
alert_email    = "you@example.com"    # confirm the SNS subscription email after apply


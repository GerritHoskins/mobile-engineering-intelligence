# Copy to .env (gitignored) and fill in. Never commit real values.

# ---- Sentry (personal org) ----
SENTRY_BASE_URL=https://us.sentry.io   # US org; EU org: https://de.sentry.io
SENTRY_ORG=                            # org slug
SENTRY_PROJECT=mei-demo-app            # project slug
SENTRY_DSN=                            # demo generator only: sends events/sessions
SENTRY_READ_TOKEN=                     # connectors: personal token, read scopes only

# ---- Jira Cloud (personal site) ----
JIRA_BASE_URL=https://<your-site>.atlassian.net
JIRA_PROJECT_KEY=MEI
JIRA_EMAIL=
JIRA_API_TOKEN=                        # no scopes exist; code only reads outside the generator

# ---- GitHub ----
GITHUB_REPO=GerritHoskins/mei-demo-app
GITHUB_READ_TOKEN=                     # fine-grained: this repo only, Contents read

# ---- LLM (app/llm/config.py) ----
LLM_PROVIDER=anthropic                 # anthropic (Claude API) | aws (Claude Platform on AWS)
ANTHROPIC_API_KEY=                     # LLM_PROVIDER=anthropic only
# LLM_PROVIDER=aws authenticates with IAM/SigV4 (AWS profile or ECS task role) instead:
# AWS_REGION=eu-central-1
# ANTHROPIC_AWS_WORKSPACE_ID=wrkspc_...
# LLM_MODEL=claude-opus-5
# LLM_EFFORT=high

# ---- Tracing (optional; unset = off) ----
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
